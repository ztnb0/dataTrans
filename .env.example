# 数据库密码配置模板
# 复制本文件为 .env 并填入真实密码（.env 已被 .gitignore 忽略，不会提交到 git）
#
# 命名规则：数据源 id 中的 - 换成 _，再大写，加 DB_ 前缀和 _PASSWORD 后缀
# 例：config.json 中数据源 id=dpt-182 -> 变量名 DB_DPT_182_PASSWORD
#     config.json 中数据源 id=dpt-aliyun -> 变量名 DB_DPT_ALIYUN_PASSWORD

DB_DPT_182_PASSWORD=
DB_DPT_ALIYUN_PASSWORD=
